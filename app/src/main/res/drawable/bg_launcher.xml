<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo estático "Liquid Glass": gradiente + arte (VectorDrawable, R1).
     Será desfocado uma vez com Modifier.blur(48.dp) no HomeScreen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1920dp"
    android:height="1080dp"
    android:viewportWidth="1920"
    android:viewportHeight="1080">

    <!-- Gradiente principal -->
    <path
        android:pathData="M0,0 L1920,0 L1920,1080 L0,1080 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1920"
                android:endY="1080"
                android:type="linear"
                android:startColor="#0A2338"
                android:centerColor="#143B57"
                android:endColor="#0B1E2F" />
        </aapt:attr>
    </path>

    <!-- Arte: mancha clara no canto superior direito (realce "vidro") -->
    <path
        android:pathData="M1920,0 C1720,0 1520,220 1520,520 C1520,820 1720,1080 1920,1080 L1920,0 Z"
        android:fillAlpha="0.7">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="1920"
                android:startY="0"
                android:endX="1520"
                android:endY="1080"
                android:type="linear"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Arte: mancha azul no canto inferior esquerdo -->
    <path
        android:pathData="M0,1080 C0,860 240,760 500,760 C820,760 1080,900 1080,1080 L0,1080 Z"
        android:fillAlpha="0.6">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="1080"
                android:endX="1080"
                android:endY="760"
                android:type="linear"
                android:startColor="#554FB3FF"
                android:endColor="#004FB3FF" />
        </aapt:attr>
    </path>
</vector>